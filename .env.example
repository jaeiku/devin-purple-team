# ---------------------------------------------------------------------------
# Devin Purple Team -- configuration
#
#   cp .env.example .env   and fill in the values you need.
#
# Nothing is hardcoded anywhere in the codebase: every service reads its
# configuration from these variables. With DEMO_MODE=true the whole flow runs
# with NO credentials at all.
# ---------------------------------------------------------------------------

# === Operating mode ========================================================
# true  -> no calls to GitHub or Devin; injections, sessions and PRs are
#          simulated and recorded in the shared store (safe for demos/video).
# false -> LIVE: commits real files and opens real issues in
#          SUPERSET_FORK_REPO, and spends real ACUs on the Devin API.
DEMO_MODE=true

# === Secrets (required when DEMO_MODE=false) ===============================
# Devin API key: https://app.devin.ai/settings/api-keys
DEVIN_API_KEY=
DEVIN_API_BASE=https://api.devin.ai

# GitHub token with `repo` scope on the Superset fork ONLY.
# Needs: contents:write (commit the synthetic file) and issues:write
# (open issues, post status comments). A fine-grained PAT scoped to the single
# fork repository is strongly recommended over a classic token.
GITHUB_TOKEN=
# Shared secret for push paths (Actions bearer token / webhook HMAC).
# Leave empty for a local demo.
BLUE_TEAM_TOKEN=
# GitHub login assigned to red-team issues (default: owner of SUPERSET_FORK_REPO)
GITHUB_ISSUE_ASSIGNEE=

# === Target repository =====================================================
# The ONLY repository the red team is ever allowed to write to. The GitHub
# client hard-refuses any other repo.
SUPERSET_FORK_REPO=jaeiku/superset
# Optional GitHub API base override:
# GITHUB_API_BASE=https://api.github.com

# === Guardrails (budget protection) ========================================
# Hard cap on ACUs a single Devin session may consume (passed as
# `max_acu_limit` on POST /v1/sessions).
MAX_ACU_PER_SESSION=10
# Maximum Devin sessions in flight at once; extra issues are queued, not
# dropped, and released by the poller as headroom frees up.
MAX_CONCURRENT_SESSIONS=2
# Global ACU ceiling across ALL sessions. Before creating a session the blue
# team checks: spend-to-date + caps reserved by in-flight sessions + this
# session's cap <= ceiling. If not, the session is refused and recorded.
GLOBAL_BUDGET_ACU_CEILING=100

# === Datastore =============================================================
# Password for the bundled Postgres container.
POSTGRES_PASSWORD=purple
# Override to point the services at an external database, e.g.
# DATABASE_URL=sqlite:////data/purple_team.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# === Host ports ============================================================
RED_TEAM_PORT=8001
BLUE_TEAM_PORT=8002
DASHBOARD_PORT=8003
# Optional public URLs for cross-navigation in preview or deployed environments.
RED_TEAM_PUBLIC_URL=
DASHBOARD_PUBLIC_URL=

# === Poller tuning =========================================================
# How often the blue team reconciles Devin session status / ACU spend.
POLL_INTERVAL_SECONDS=15
# DEMO_MODE only: how long a simulated session "works" before producing a PR.
SIMULATED_SESSION_SECONDS=20
